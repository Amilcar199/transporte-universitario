# Copie para .env e preencha. Nunca coloque segredos reais neste ficheiro de exemplo.
# A API valida estas variáveis no arranque e recusa iniciar se faltar alguma obrigatória.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL em produção: postgres://utilizador:palavra-passe@servidor:5432/base
# Desenvolvimento sem PostgreSQL instalado: PostgreSQL embutido (PGlite) guardado em disco.
DATABASE_URL=pglite:./data/dev

# Obrigatórios, com pelo menos 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
PASS_TOKEN_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Validade de cada código QR do passe (a app renova-o automaticamente).
PASS_TOKEN_TTL_SECONDS=60

# Origens autorizadas (painel administrativo e app web), separadas por vírgulas.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
AUTH_RATE_LIMIT_PER_MINUTE=10

# Pagamentos. O ambiente de testes simula a confirmação de um fornecedor e é recusado em produção.
PAYMENTS_SANDBOX_ENABLED=false
# Dados bancários mostrados para transferência; o financeiro confirma cada pagamento manualmente.
# Deixe vazio enquanto não houver conta bancária oficial: o método fica indisponível.
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BENEFICIARY=

# Apenas desenvolvimento: devolve o código de recuperação de palavra-passe na resposta,
# porque ainda não existe envio por SMS/email configurado. Recusado em produção.
DEV_EXPOSE_RESET_CODES=false

# Opcional, só para o script de demonstração (npm run db:seed:demo). Se vazio, é gerada uma aleatória.
# SEED_DEMO_PASSWORD=
