# Endereço da API. Variáveis EXPO_PUBLIC_* ficam embutidas na app: nunca coloque segredos aqui.
# No browser (expo start --web) use localhost. Num telemóvel com Expo Go, use o IP da máquina na rede local,
# por exemplo http://192.168.1.20:4000/api/v1, e garanta que a API aceita ligações nessa interface (HOST=0.0.0.0).
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
